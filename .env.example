# ---------------------------------------------------------------------------
# Values your n8n instance needs before these workflows will run.
# Nothing here is a secret in this repository — fill in your own and keep the
# resulting .env out of git.
# ---------------------------------------------------------------------------

# --- OpenAI ---------------------------------------------------------------
# Stored in n8n as a "Header Auth" credential, NOT as an environment variable:
#   Name:  Authorization
#   Value: Bearer sk-your-openai-key
OPENAI_API_KEY=sk-replace-with-your-openai-key

# --- Telegram -------------------------------------------------------------
# Bot token goes into an n8n "Telegram API" credential.
TELEGRAM_BOT_TOKEN=0000000000:replace-with-your-bot-token
# Chat IDs replace the REPLACE_WITH_TELEGRAM_CHAT_ID placeholders in the nodes.
TELEGRAM_SALES_CHAT_ID=-1000000000000
TELEGRAM_ALERTS_CHAT_ID=-1000000000000

# --- Google Sheets --------------------------------------------------------
# The long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=replace-with-your-spreadsheet-id

# --- n8n ------------------------------------------------------------------
# Only needed if you switch the placeholders to {{ $env.VARIABLE }} expressions.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
