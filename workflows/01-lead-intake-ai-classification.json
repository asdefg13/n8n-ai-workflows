      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\": \"received\", \"priority\": \"{{ $json.priority }}\"}",
        "options": {}
      },
      "id": "00000001-0000-4000-8000-000000000009",
