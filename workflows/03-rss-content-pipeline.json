            "Source Link": "={{ $json.link }}",
            "Published At": "={{ $json.published_at }}",
            "Hook": "={{ $json.hook }}",
            "Post": "={{ $json.post }}",
            "Hashtags": "={{ $json.hashtags }}",
            "Status": "draft"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "00000003-0000-4000-8000-000000000007",
      "name": "Save Draft to Sheet",
