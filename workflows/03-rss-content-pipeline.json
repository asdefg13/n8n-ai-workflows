      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "chatId": "REPLACE_WITH_TELEGRAM_CHAT_ID",
        "text": "=📝 <b>New post draft</b>\n\n{{ $json.post }}\n\n———\nSource: {{ $json.title }}\n{{ $json.link }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
      "id": "00000003-0000-4000-8000-000000000008",
