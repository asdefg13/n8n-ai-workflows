            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Invoice": {
      "main": [
        [
          {
            "node": "Extraction Trustworthy?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraction Trustworthy?": {
      "main": [
        [
          {
            "node": "Append to Expenses",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Ask for a Better Photo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append to Expenses": {
      "main": [
        [
          {
